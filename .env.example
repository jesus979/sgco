# =========================================
# SGCO - Configuración de entorno
# =========================================
# Copiar este archivo a `.env` y rellenar los valores:
#   cp .env.example .env
# Nunca commitear el archivo `.env` real.
#
# SEGURIDAD: las credenciales de demo (admin/admin123) son SOLO
# para desarrollo local. En producción se debe cambiar SECRET_KEY
# y crear un superusuario con contraseña robusta.

# Clave secreta de Django. Generar una nueva para producción:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-cambiar-en-produccion

# DEBUG: True para desarrollo, False para producción.
# NUNCA True en producción.
DEBUG=True

# Hosts permitidos separados por coma.
# En desarrollo: localhost,127.0.0.1
# En producción: tudominio.com,www.tudominio.com
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Zona horaria (por defecto America/Mexico_City)
TIME_ZONE=America/Mexico_City

# Idioma (por defecto es-mx)
LANGUAGE_CODE=es-mx

# Nivel de logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# =========================================
# Base de datos
# =========================================
# Por defecto: SQLite local (desarrollo).
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Para PostgreSQL, descomentar y rellenar.
# Acepta tanto POSTGRES_<NAME> como DB_<NAME> como nombres de
# variables (prioriza POSTGRES_<NAME> si existe).
#
# DB_ENGINE=django.db.backends.postgresql
# POSTGRES_DB=sgco
# POSTGRES_USER=sgco
# POSTGRES_PASSWORD=********
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_CONN_MAX_AGE=60
